# npm Automation token used to publish the @prose-motions/* packages.
#
# Generate one at: npmjs.com -> avatar -> Access Tokens -> Generate New Token
#   - Classic -> "Automation"  (bypasses 2FA), or
#   - Granular -> read+write on the @prose-motions scope
#
# Copy this file to .env and paste your real token (the .env file is gitignored).
NPM_TOKEN=npm_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
