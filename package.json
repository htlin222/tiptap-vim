{
  "name": "prose-motions",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.1.8",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "clean": "rm -rf packages/*/dist",
    "build": "bun run --cwd packages/engine build && bun run --cwd packages/adapter build && bun run --cwd packages/core build",
    "dev": "bun run --hot packages/core dev",
    "pretest": "bun run --cwd packages/engine build && bun run --cwd packages/adapter build && bun run --cwd packages/core build && bun run --cwd packages/pm build",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:list": "vitest run --reporter verbose",
    "lint": "eslint \"**/*.{ts,tsx}\"",
    "presize": "bun run build",
    "size": "size-limit",
    "pack:dry": "for p in engine adapter core pm styles statusbar-vanilla statusbar-react; do (cd packages/$p && npm pack --dry-run); done"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.13.2",
    "@size-limit/preset-small-lib": "^11",
    "@tiptap/starter-kit": "^2.2.1",
    "@vitest/coverage-v8": "3.1.4",
    "@vitest/ui": "^3.1.4",
    "eslint": "^9.0.0",
    "jsdom": "^24.0.0",
    "prettier": "^3.5.3",
    "size-limit": "^11",
    "typescript": "^5.4.5",
    "vitest": "^3.1.4"
  },
  "size-limit": [
    {
      "name": "core + adapter + engine (combined, consumer bundle)",
      "path": [
        "packages/engine/dist/src/index.js",
        "packages/adapter/dist/src/index.js",
        "packages/core/dist/src/index.js"
      ],
      "limit": "120 KB",
      "ignore": [
        "@tiptap/core",
        "@tiptap/pm"
      ]
    },
    {
      "name": "statusbar-vanilla",
      "path": "packages/statusbar-vanilla/dist/src/index.js",
      "limit": "5 KB",
      "ignore": ["@tiptap/core", "@prose-motions/core"]
    }
  ],
  "version": "0.1.2"
}
