{
  "name": "prose-motions",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.1.8",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "clean": "rm -rf packages/*/dist",
    "build": "bun run --cwd packages/engine build && bun run --cwd packages/adapter build && bun run --cwd packages/core build",
    "dev": "bun run --hot packages/core dev",
    "pretest": "bun run --cwd packages/engine build && bun run --cwd packages/adapter build && bun run --cwd packages/core build",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:list": "vitest run --reporter verbose",
    "lint": "eslint \"**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.13.2",
    "@tiptap/starter-kit": "^2.2.1",
    "@vitest/coverage-v8": "3.1.4",
    "@vitest/ui": "^3.1.4",
    "eslint": "^9.0.0",
    "jsdom": "^24.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.4.5",
    "vitest": "^3.1.4"
  },
  "version": "0.1.2"
}
