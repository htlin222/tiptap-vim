{
  "name": "@prose-motions/adapter",
  "version": "0.0.0",
  "private": true,
  "description": "CodeMirror-shaped adapter over a ProseMirror EditorView — skeleton.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/src/index.js",
  "module": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build:types": "tsc -p tsconfig.build.json",
    "build:esm": "bun build ./src/index.ts --outdir ./dist/src --target node --format esm --external '@tiptap/*' --external '@prose-motions/*'",
    "build": "bun run clean && bun run build:types && bun run build:esm"
  },
  "peerDependencies": {
    "@tiptap/pm": "^2"
  },
  "dependencies": {
    "@prose-motions/engine": "workspace:*"
  },
  "files": [
    "dist/**/*"
  ]
}
