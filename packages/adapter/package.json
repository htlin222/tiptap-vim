{
  "name": "@prose-motions/adapter",
  "version": "1.0.0",
  "description": "CodeMirror-shaped adapter over a ProseMirror EditorView — powers prose-motions.",
  "author": "Stratum Labs <hq@stratumlabs.ai>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stratum-labs/prose-motions.git",
    "directory": "packages/adapter"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "module": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build:types": "tsc -p tsconfig.build.json",
    "build:esm": "bun build ./src/index.ts --outdir ./dist/src --target node --format esm --external '@tiptap/*' --external '@prose-motions/*'",
    "build": "bun run clean && bun run build:types && bun run build:esm"
  },
  "peerDependencies": {
    "@tiptap/pm": "^2"
  },
  "dependencies": {
    "@prose-motions/engine": "workspace:*",
    "@replit/codemirror-vim": "^6.2.0"
  },
  "files": [
    "dist/**/*"
  ]
}
